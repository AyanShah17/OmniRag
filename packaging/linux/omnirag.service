[Unit]
Description=OmniRAG Dynamic Enterprise RAG Backend
After=network.target local-fs.target

[Service]
Type=simple
User=omnirag
Group=omnirag
EnvironmentFile=/etc/omnirag/omnirag.env
WorkingDirectory=/usr/lib/omnirag/python-rag
ExecStartPre=/usr/bin/test -f /etc/omnirag/omnirag.env
ExecStart=/usr/bin/python3 -m uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5s
LimitNOFILE=65536
StandardOutput=append:/var/log/omnirag/omnirag.log
StandardError=append:/var/log/omnirag/omnirag.err

[Install]
WantedBy=multi-user.target
