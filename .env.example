# ==============================================================================
# OmniRAG SaaS Platform - Environment Configuration
# ==============================================================================

# General
ENVIRONMENT=development
LOG_LEVEL=info
SECRET_KEY=omnirag-super-secret-jwt-and-encryption-key-2026

# Service Ports
GO_ENGINE_PORT=8080
PYTHON_RAG_PORT=8000

# ------------------------------------------------------------------------------
# PostgreSQL / Supabase Database
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/omnirag_db
GO_DATABASE_URL=postgres://postgres:postgres@localhost:5432/omnirag_db?sslmode=disable
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=omnirag_db
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# Redis / Upstash Task Queue
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ------------------------------------------------------------------------------
# Vector Store: Pinecone
# ------------------------------------------------------------------------------
PINECONE_API_KEY=
PINECONE_INDEX_NAME=omnirag-index
PINECONE_ENVIRONMENT=us-east-1
PINECONE_DIMENSION=384
PINECONE_METRIC=cosine
# Set to 'pinecone' or 'mock' (for local automated testing without live credentials)
VECTOR_STORE_PROVIDER=mock

# ------------------------------------------------------------------------------
# LLM & Embedding Providers (OpenRouter, Groq, FastEmbed, OpenAI)
# ------------------------------------------------------------------------------
# Default Embedding: 'fastembed' (local ONNX, $0 cost, zero API keys required) or 'openrouter', 'openai'
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Default LLM Provider: 'openrouter', 'groq', 'openai', 'mock'
LLM_PROVIDER=mock
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ------------------------------------------------------------------------------
# Connector Default Credentials (Can also be configured per tenant/workspace in DB)
# ------------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER_NAME=

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

CONFLUENCE_DOMAIN=
CONFLUENCE_EMAIL=
CONFLUENCE_API_TOKEN=
