# ==============================================================================
# OmniRAG SaaS Platform - Environment Configuration
# ==============================================================================

# General
ENVIRONMENT=development
LOG_LEVEL=info
# AES-256-GCM Encryption Key (64-char hex = 32 bytes)
# Used to encrypt connector credentials at rest in PostgreSQL
# Replace this development value before any production deployment.
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Service Ports
GO_ENGINE_PORT=8080
PYTHON_RAG_PORT=8000
MAX_UPLOAD_BYTES=26214400
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# Clerk Authentication (https://clerk.com)
# ------------------------------------------------------------------------------
# Leave blank for local dev mode (auto-fallback to mock user session)
CLERK_SECRET_KEY=
CLERK_JWKS_URL=
CLERK_ISSUER=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# ------------------------------------------------------------------------------
# Auth Mode & Internal Service Secret
# ------------------------------------------------------------------------------
# "development" allows unauthenticated requests to fall back to a local dev
# identity. "production" requires a valid Clerk JWT on every request.
AUTH_MODE=development
# Shared secret for Go engine -> Python internal endpoint calls (e.g.
# /internal/embed-chunks). Required when AUTH_MODE=production.
INTERNAL_SERVICE_SECRET=

# ------------------------------------------------------------------------------
# PostgreSQL / Supabase / NeonDB Database
# ------------------------------------------------------------------------------
# Supabase: postgresql+asyncpg://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
# NeonDB:   postgresql+asyncpg://[user]:[password]@[host].neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/omnirag_db
GO_DATABASE_URL=postgres://postgres:postgres@localhost:5432/omnirag_db?sslmode=disable
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=omnirag_db
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# Vector Store: Pinecone
# ------------------------------------------------------------------------------
PINECONE_API_KEY=
PINECONE_INDEX_NAME=omnirag-index
PINECONE_ENVIRONMENT=us-east-1
PINECONE_DIMENSION=384
PINECONE_METRIC=cosine
# Set to 'pinecone' or 'mock' (for local automated testing without live credentials)
VECTOR_STORE_PROVIDER=mock

# ------------------------------------------------------------------------------
# LLM & Embedding Providers (OpenRouter, Groq, FastEmbed, OpenAI)
# ------------------------------------------------------------------------------
# Default Embedding: 'fastembed' (local ONNX, $0 cost, zero API keys required) or 'openrouter', 'openai'
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Default LLM Provider: 'openrouter', 'groq', 'openai', 'mock'
LLM_PROVIDER=mock
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ------------------------------------------------------------------------------
# Connector Default Credentials (Can also be configured per tenant/workspace in DB)
# ------------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER_NAME=

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

CONFLUENCE_DOMAIN=
CONFLUENCE_EMAIL=
CONFLUENCE_API_TOKEN=
