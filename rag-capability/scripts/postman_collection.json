{
  "info": {
    "name": "OmniRAG - Enterprise Dynamic RAG SaaS API",
    "description": "Postman collection for OmniRAG hybrid Go + Python Dynamic RAG backend with multi-cloud connectors, chunk-level diffing, and streaming SSE chat with citations.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health & System Status",
      "item": [
        {
          "name": "Python RAG Core Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8000/api/v1/healthz",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["api", "v1", "healthz"]
            }
          }
        },
        {
          "name": "Go Connector Engine Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8080/healthz",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["healthz"]
            }
          }
        }
      ]
    },
    {
      "name": "Connectors & Cloud Crawlers (Go Engine)",
      "item": [
        {
          "name": "Register AWS S3 Connector",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"workspace_id\": \"ws_default\",\n  \"type\": \"s3\",\n  \"name\": \"Corporate Knowledge S3 Bucket\",\n  \"config\": {\n    \"bucket\": \"my-company-knowledge-base\",\n    \"region\": \"us-east-1\",\n    \"prefix\": \"documents/\",\n    \"access_key_id\": \"AKIA...\",\n    \"secret_access_key\": \"...\"\n  },\n  \"sync_frequency\": \"hourly\"\n}"
            },
            "url": {
              "raw": "http://localhost:8080/api/v1/connectors",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "v1", "connectors"]
            }
          }
        },
        {
          "name": "Register Azure Blob Connector",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"workspace_id\": \"ws_default\",\n  \"type\": \"azure_blob\",\n  \"name\": \"Azure Enterprise Container\",\n  \"config\": {\n    \"container_name\": \"rag-docs\",\n    \"account_name\": \"mystorageaccount\",\n    \"connection_string\": \"DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...\"\n  },\n  \"sync_frequency\": \"daily\"\n}"
            },
            "url": {
              "raw": "http://localhost:8080/api/v1/connectors",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "v1", "connectors"]
            }
          }
        },
        {
          "name": "Register Confluence Cloud Connector",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"workspace_id\": \"ws_default\",\n  \"type\": \"confluence\",\n  \"name\": \"Engineering Confluence Wiki\",\n  \"config\": {\n    \"domain\": \"https://mycompany.atlassian.net\",\n    \"email\": \"admin@mycompany.com\",\n    \"api_token\": \"...\",\n    \"space_key\": \"ENG\"\n  },\n  \"sync_frequency\": \"hourly\"\n}"
            },
            "url": {
              "raw": "http://localhost:8080/api/v1/connectors",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "v1", "connectors"]
            }
          }
        },
        {
          "name": "Trigger Immediate Manual/Online Sync",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "http://localhost:8080/api/v1/connectors/{{connector_id}}/sync",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "v1", "connectors", "{{connector_id}}", "sync"]
            }
          }
        }
      ]
    },
    {
      "name": "Documents & Incremental Diffing (Python RAG)",
      "item": [
        {
          "name": "Upload & Ingest Document (Multipart)",
          "request": {
            "method": "POST",
            "header": [{ "key": "X-Workspace-ID", "value": "ws_default" }],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": ""
                }
              ]
            },
            "url": {
              "raw": "http://localhost:8000/api/v1/documents/upload",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["api", "v1", "documents", "upload"]
            }
          }
        },
        {
          "name": "List Workspace Documents",
          "request": {
            "method": "GET",
            "header": [{ "key": "X-Workspace-ID", "value": "ws_default" }],
            "url": {
              "raw": "http://localhost:8000/api/v1/documents",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["api", "v1", "documents"]
            }
          }
        },
        {
          "name": "Get Document Version History",
          "request": {
            "method": "GET",
            "header": [{ "key": "X-Workspace-ID", "value": "ws_default" }],
            "url": {
              "raw": "http://localhost:8000/api/v1/documents/{{document_id}}/versions",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["api", "v1", "documents", "{{document_id}}", "versions"]
            }
          }
        }
      ]
    },
    {
      "name": "Streaming RAG Chat with Grounded Citations",
      "item": [
        {
          "name": "Create Conversation Session",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Workspace-ID", "value": "ws_default" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Security Audit Q&A\"\n}"
            },
            "url": {
              "raw": "http://localhost:8000/api/v1/chat/conversations",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["api", "v1", "chat", "conversations"]
            }
          }
        },
        {
          "name": "Stream RAG Completion (SSE)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Workspace-ID", "value": "ws_default" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"What is our incident response SLA for cloud security?\"\n    }\n  ],\n  \"top_k\": 10,\n  \"rerank_top_n\": 4,\n  \"acl_roles\": [\"engineering\", \"security\"]\n}"
            },
            "url": {
              "raw": "http://localhost:8000/api/v1/chat/completions/stream",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["api", "v1", "chat", "completions", "stream"]
            }
          }
        }
      ]
    }
  ]
}
